[TEMPLATE]
APP_NAME="Metrial Portfolio API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Cairo
APP_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Portfolio platform (SRS-BE §7)
# ---------------------------------------------------------------------------
# Public site origin: used for entity URLs, IndexNow pings, and CV links.
PUBLIC_SITE_URL=http://localhost:3000
# Frontend origin the API knows about (kept in sync with CORS below).
FRONTEND_URL=http://localhost:3000
# Signed webhook target the outbox relay sends portfolio.content_changed to
# (registered via `php artisan portfolio:register-frontend-webhook` in BE-5).
FRONTEND_REVALIDATE_WEBHOOK_URL=
# Shared HMAC secret for outgoing revalidation webhooks.
FRONTEND_REVALIDATE_SECRET=
# IndexNow key; the frontend serves it at /{INDEXNOW_KEY}.txt (FR-BE-85).
INDEXNOW_KEY=
# GitHub public-profile sync for the v1.1 showcase (FR-BE-75). Token optional.
GITHUB_USERNAME=KaremMetrial
GITHUB_TOKEN=
# Shared secret for the server-side bot-challenge verification (FR-BE-41).
BOT_CHALLENGE_SECRET=
# Where accepted contact submissions notify the owner (FR-BE-43).
OWNER_NOTIFICATION_EMAIL=
# Raw analytics event retention in days (FR-BE-63).
ANALYTICS_RAW_RETENTION_DAYS=90
# Seed the base's enterprise demo content. OFF for the portfolio: the
# portfolio seeders (BE-1) are the default, so `make fresh` yields CV content.
SEED_ENTERPRISE_DEMO=false
# Public self-registration is disabled (FR-BE-25). Owner accounts are created
# with: php artisan portfolio:create-owner
FEATURE_PUBLIC_REGISTRATION=false

# ---------------------------------------------------------------------------
# CORS / Sanctum
# ---------------------------------------------------------------------------
# Comma-separated. Leave empty locally to allow no cross-origin requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,127.0.0.1:8000,::1

# ---------------------------------------------------------------------------
# Localization
# ---------------------------------------------------------------------------
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
SUPPORTED_LOCALES=en,ar

# ---------------------------------------------------------------------------
# Database (PostgreSQL by default; production target is MySQL 8.4 — the base
# supports both, flip DB_CONNECTION + the compose service when deploying)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=metrial_portfolio
DB_USERNAME=postgres
DB_PASSWORD=secret

# ---------------------------------------------------------------------------
# Cache / Queue / Session
# ---------------------------------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=cookie
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Socket.IO real-time delivery
# ---------------------------------------------------------------------------
REALTIME_ENABLED=false
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
REALTIME_MAX_EVENT_BYTES=65536
REALTIME_INTERNAL_SECRET=
REALTIME_EVENT_HMAC_SECRET=

# ---------------------------------------------------------------------------
# Multi-tenancy
# ---------------------------------------------------------------------------
TENANCY_ENABLED=false
TENANCY_HEADER=X-Tenant

# ---------------------------------------------------------------------------
# Governance
# ---------------------------------------------------------------------------
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=365
APPROVALS_ENABLED=true
IDEMPOTENCY_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Payments (module disabled for the portfolio — vars kept for base reuse)
# ---------------------------------------------------------------------------
PAYMENT_DEFAULT=stripe
PAYMENT_CURRENCY=EGP

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

FAWRY_BASE_URL=https://atfawry.fawrystaging.com
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=

PAYTABS_BASE_URL=https://secure-egypt.paytabs.com
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=

# ---------------------------------------------------------------------------
# Outgoing webhooks
# ---------------------------------------------------------------------------
WEBHOOK_MAX_TRIES=5
WEBHOOK_TIMEOUT=10

# ---------------------------------------------------------------------------
# SMS providers
# ---------------------------------------------------------------------------
SMS_DEFAULT=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_FROM=

# ---------------------------------------------------------------------------
# Push
# ---------------------------------------------------------------------------
FCM_CREDENTIALS=
FCM_PROJECT_ID=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Translation Subsystem
# ---------------------------------------------------------------------------
AUTO_TRANSLATION_ENABLED=true
AUTO_TRANSLATION_PROVIDER=gemini
AUTO_TRANSLATION_QUEUE=translations
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-1.5-flash
GEMINI_PROMPT_VERSION=v1

# ---------------------------------------------------------------------------
# API documentation (Scramble) — disabled in production (plan BE-6)
# ---------------------------------------------------------------------------
SCRAMBLE_ENABLED=true
SCRAMBLE_PUBLIC_ACCESS=true
SCRAMBLE_ALLOWED_ENVIRONMENTS=local,testing,staging

# ---------------------------------------------------------------------------
# Module toggles (config/modules.php)
# ---------------------------------------------------------------------------
# Portfolio keeps Media (project images, CV PDFs), Webhook (revalidation
# events), and Governance (audit, settings, feature flags) ON; the rest of
# the enterprise capabilities are off (SRS-BE §2.2).
MODULE_PAYMENT_ENABLED=false
MODULE_WALLET_ENABLED=false
MODULE_COMMUNICATION_ENABLED=false
MODULE_INTEGRATION_OAUTH_ENABLED=false

# Portfolio-specific modules (added in BE-0; each module's routes gate on
# its flag, so a disabled module simply does not exist).
MODULE_PORTFOLIO_ENABLED=true
MODULE_CONTACT_ENABLED=true
MODULE_ANALYTICS_ENABLED=true
MODULE_SHOWCASE_ENABLED=true
MODULE_INSIGHTS_ENABLED=true
