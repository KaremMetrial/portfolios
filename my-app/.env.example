# Metrial Portfolio web app (SRS-FE §6). Copy to .env.local.

# Canonical base URL. Anything other than the production origin is noindex.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser calls: console, analytics beacon, health strip. Also the next/image media origin.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Socket.IO endpoint for presence (v1.1).
NEXT_PUBLIC_REALTIME_URL=http://localhost:6001
# Bot challenge widget site key (Q-6).
NEXT_PUBLIC_BOT_CHALLENGE_SITE_KEY=

# Server-only
# Server-side API fetches (may be a private network URL).
API_INTERNAL_URL=http://localhost:8000
# Webhook HMAC secret, same value as the backend FRONTEND_REVALIDATE_SECRET (min 32 chars).
REVALIDATE_SECRET=
# live | fixtures (fixtures until the backend contract freeze, M1).
API_MODE=fixtures
